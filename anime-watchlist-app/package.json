{
  "name": "anime-watchlist",
  "productName": "Anime Watchlist",
  "version": "1.0.0",
  "description": "A draggable anime watchlist desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.morakinyo.animewatchlist",
    "productName": "Anime Watchlist",
    "files": ["main.js", "index.html"],
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false }
  }
}
